als.ts",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/community.wellcall.biz/src/App.tsx",["30","31"],"import React from \"react\";\nimport \"./App.css\";\nimport { BrowserRouter as Router, Switch, Route, Link } from \"react-router-dom\";\nimport Home from \"./main/home/home\";\nimport About from \"./main/about/about\";\nimport SideNav from \"./main/side-nav/sideNav\";\nimport logo from \"./images/Community We'll Call Logo No Padding.png\";\nimport { MailOutlined, PhoneOutlined } from \"@ant-design/icons\";\n\nfunction App() {\n  return (\n    <div className=\"App\">\n      <SideNav />\n      <header className=\"App-header\">\n        <div className=\"col-33 menu-btn\" onClick={() => openNav()}>\n          <div className=\"menu-line\"></div>\n          <div className=\"menu-line\"></div>\n          <div className=\"menu-line\"></div>\n        </div>\n        <div className=\"col-33\">\n          <img src={logo} className=\"logo col-50\" />\n        </div>\n        <div className=\"col-33\"></div>\n      </header>\n\n      <div className=\"App-main\">\n        <Router>\n          <Switch>\n            <Route path=\"/about\">\n              <About />\n            </Route>\n            <Route path=\"/\">\n              <Home />\n            </Route>\n          </Switch>\n        </Router>\n      </div>\n\n      <footer className=\"App-footer\">\n        <div className=\"col-33\">\n          <a href={\"mailto:admin@wellcall.biz\"}>\n            <MailOutlined />\n          </a>\n        </div>\n        <div className=\"col-33\">\n          <button\n            type=\"submit\"\n            onClick={() =>\n              window.open(\"https://facebook.com/WellCallTechConsulting\", \"_blank\")\n            }\n          >\n            Schedule An Appointment Now\n          </button>\n        </div>\n        <div className=\"col-33\">\n          <a href={\"tel:559-574-1056\"}>\n            <PhoneOutlined />\n          </a>\n        </div>\n      </footer>\n    </div>\n  );\n}\n\n/* Set the width of the side navigation to 250px */\nfunction openNav() {\n  if (document.getElementById(\"mySidenav\")) {\n    document.getElementById(\"mySidenav\")!.style.width = \"250px\";\n  }\n}\n\nexport default App;\n","/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/community.wellcall.biz/src/main/home/home.tsx",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/community.wellcall.biz/src/main/about/about.tsx",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/community.wellcall.biz/src/main/side-nav/sideNav.tsx",["32","33","34","35","36"],{"ruleId":"37","replacedBy":"38"},{"ruleId":"39","replacedBy":"40"},{"ruleId":"41","severity":1,"message":"42","line":3,"column":50,"nodeType":"43","messageId":"44","endLine":3,"endColumn":54},{"ruleId":"45","severity":1,"message":"46","line":21,"column":11,"nodeType":"47","endLine":21,"endColumn":53},{"ruleId":"41","severity":1,"message":"48","line":5,"column":3,"nodeType":"43","messageId":"44","endLine":5,"endColumn":17},{"ruleId":"41","severity":1,"message":"49","line":10,"column":3,"nodeType":"43","messageId":"44","endLine":10,"endColumn":22},{"ruleId":"41","severity":1,"message":"50","line":11,"column":3,"nodeType":"43","messageId":"44","endLine":11,"endColumn":19},{"ruleId":"51","severity":1,"message":"52","line":73,"column":9,"nodeType":"47","endLine":76,"endColumn":10},{"ruleId":"51","severity":1,"message":"52","line":79,"column":9,"nodeType":"47","endLine":79,"endColumn":78},"no-native-reassign",["53"],"no-negated-in-lhs",["54"],"@typescript-eslint/no-unused-vars","'Link' is defined but never used.","Identifier","unusedVar","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","'GithubOutlined' is defined but never used.","'AppstoreAddOutlined' is defined but never used.","'SolutionOutlined' is defined but never used.","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https:/